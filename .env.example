# Copy to .env and fill in locally; never commit .env.
# Hugging Face: the namespace (user or organization) that will own the dataset repository.
HF_NAMESPACE=
# The token is read by huggingface_hub from `hf auth login` or from HF_TOKEN; leave empty here.
HF_TOKEN=
# Where the original task files and harvest live (the generator's output root), for reproduction scripts.
SUFFICE_BENCH_DIR=
